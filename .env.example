# Frontend API base URL.
#
# Read at build time by Vite as import.meta.env.VITE_API_URL.
# Fallback when unset or empty: http://127.0.0.1:8000 (see
# src/lib/apiClient.ts:4 and src/components/Shared/BackendBanner.tsx:4).
#
# There is no mock-data mode -- an empty value does NOT switch the
# frontend to mocks. It falls back to localhost, which will fail to
# reach a backend in any deployment that isn't on the same machine.
#
# For local dev: leave as-is (or omit the file entirely -- the
# default already points at localhost:8000).
#
# For a deployed build: set this in the GitHub Actions workflow env
# (or your equivalent CI) to your backend URL. GitHub Pages builds
# without this variable will try to reach localhost:8000 and fail.
VITE_API_URL=http://127.0.0.1:8000
