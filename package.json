{
    "name":  "mutual-circle-prototype",
    "description":  "R.U.T.H - The Mutual Circle: anonymized resource-sharing network prototype (LumiereCore CLG)",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --port=3000 --host=0.0.0.0",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "clean":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})\"",
                    "lint":  "tsc --noEmit",
                    "predeploy":  "npm run build \u0026\u0026 node -e \"const fs=require(\u0027fs\u0027);fs.copyFileSync(\u0027dist/index.html\u0027,\u0027dist/404.html\u0027)\"",
                    "deploy":  "gh-pages -d dist"
                },
    "dependencies":  {
