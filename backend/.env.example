# Mutual Circle — backend env
# Copy to .env and fill real values

# Runtime
ENVIRONMENT=development
LOG_LEVEL=info

# Database (Neon Postgres)
DATABASE_URL_MAIN=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# DATABASE_URL_BENCH (unused today — reserved for the future Bench
# peer-support database; the current Bench tab is a stub reading from
# the main database)
DATABASE_URL_BENCH=

# DATABASE_URL_MESSAGING (unused today — reserved for the encrypted
# messaging store; MESSAGING_ENCRYPTION_KEY below is also unused)
DATABASE_URL_MESSAGING=

# HMAC keys (hex, 32 bytes = 64 chars)
LEDGER_HMAC_KEY=
TOKEN_HMAC_KEY_CURRENT=
TOKEN_HMAC_KEY_PREVIOUS=
MESSAGING_ENCRYPTION_KEY=
JWT_SECRET=

# Staff PINs (bcrypt hash)
STAFF_ENROL_ID=ENROL-04
STAFF_ENROL_PIN_HASH=
STAFF_FULF_ID=FULF-08
STAFF_FULF_PIN_HASH=
STAFF_AUDIT_ID=AUDIT-02
STAFF_AUDIT_PIN_HASH=

# Paystack (donations + pledges)
# Secret key from Paystack dashboard -> Settings -> API Keys & Webhooks.
# Use the sk_test_... key locally. Put the real value ONLY in backend/.env
# (gitignored), never in this file. It also verifies webhook signatures.
PAYSTACK_SECRET_KEY=
# Currency sent to Paystack. Amounts are sent in its lowest unit
# (KES cents), which is what the *_pence columns already hold.
PAYSTACK_CURRENCY=KES
# Frontend page Paystack returns the donor to after checkout.
PAYSTACK_CALLBACK_URL=http://localhost:3000/mutual-circle/donor/payment-return
