# Mutual Circle — backend env
# Copy to .env and fill real values

# Runtime
ENVIRONMENT=development
LOG_LEVEL=info

# Database (Neon Postgres)
DATABASE_URL_MAIN=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_BENCH=
DATABASE_URL_MESSAGING=

# HMAC keys (hex, 32 bytes = 64 chars)
LEDGER_HMAC_KEY=
TOKEN_HMAC_KEY_CURRENT=
TOKEN_HMAC_KEY_PREVIOUS=
MESSAGING_ENCRYPTION_KEY=
JWT_SECRET=

# Staff PINs (bcrypt hash)
STAFF_ENROL_ID=ENROL-04
STAFF_ENROL_PIN_HASH=
STAFF_FULF_ID=FULF-08
STAFF_FULF_PIN_HASH=
STAFF_AUDIT_ID=AUDIT-02
STAFF_AUDIT_PIN_HASH=

# Demo flags (declared but not read)
MOCK_SMS=true
MOCK_MPESA=true
MOCK_LOCKER=true
MOCK_OCR=true